            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "crane_outage-5",
              "name": "Terminal ops",
              "text": "2 of the terminal's 9 quay cranes are out of service from hour 108 to hour 155 (gantry repair): 7 cranes in that window."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-14",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Thu 09:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 144: above 25 kn hours 84–88, peak 31 kn; above 30 kn 84–85."
            }
          }
        ]
      },
      {
        "id": "watch-6",
