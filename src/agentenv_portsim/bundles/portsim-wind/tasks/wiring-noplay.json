              "text": "Ships 12, 13, 14 were held up by the Red Sea diversions and now arrive together between hours 156 and 168 (each ship's arrival hour is in the table). Their planned departures stay as published."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-16",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Fri 21:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 180: no hour above 25 kn, peak 12 kn."
            }
          }
        ]
      }
    ]
  },
  {
    "id": "clock",
    "type": "sync_env_clock",
    "env_id": "portsim-wind",
    "virtual_time": "2024-02-12T00:00:00Z",
    "virtual_seconds_per_real_second": 0,
    "tolerate_missing_sync_time": false
  },
  {
    "id": "end-week",
    "type": "apply_server_config",
    "env_id": "portsim-wind",
    "directives": [
      {
        "service": "portsim-wind",
        "uri": "urn:portsim:end-week/v1",
        "args": {}
      }
    ]
  },
  {
    "id": "grade",
    "type": "env_outcome_verifier",
    "env_id": "portsim-wind",
    "file_artifact_id": "portsim-live-verifier",
    "verifier_id": "portsim",
    "score_aggregator": "weighted_average"
  }
]
