              "equals": 6
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-15",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Thu 15:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 150: no hour above 25 kn, peak 19 kn."
            }
          }
        ]
      },
      {
        "id": "watch-7",
