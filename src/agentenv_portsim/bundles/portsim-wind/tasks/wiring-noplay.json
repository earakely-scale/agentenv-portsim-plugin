[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "portsim-wind"
  },
  {
    "id": "load-task",
    "type": "apply_server_config",
    "env_id": "portsim-wind",
    "directives": [
      {
        "service": "portsim-wind",
        "uri": "urn:portsim:live-load/v1",
        "args": {
          "task_id": "dock-24B-w07x1-busy-0-e00"
        }
      }
    ]
  },
  {
    "id": "hide-port-notice",
    "type": "modify_env_tool_access",
    "env_id": "portsim-wind",
    "action": "disable",
    "role": "default",
    "tools": [
      "port_notice"
    ]
  },
  {
    "id": "watches",
    "type": "register_env_triggers",
    "env_id": "portsim-wind",
    "watch_roles": [
      "default"
    ],
    "triggers": [
      {
        "id": "watch-1",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 1
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "extra-0",
              "name": "MAERSK NUBA",
              "text": "Unscheduled call: ship 16 MAERSK NUBA (211 m, 5 sections) arrives at hour 58, has 672 moves and asks to sail by hour 74. It has no planned slot, so placing it anywhere costs no move penalty."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "tug_outage-7",
              "name": "Tug company",
              "text": "2 of the port's 8 tugs are out of service from hour 54 to hour 78: 6 tugs in that window."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "pilot_shortage-8",
              "name": "Pilot station",
              "text": "2 of the port's 7 pilots on duty are unavailable from hour 54 to hour 66: 5 pilots in that window."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-10",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Tue 03:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 90: above 25 kn hours 75–85, peak 32 kn; above 30 kn 77–80."
            }
          }
        ]
      },
      {
        "id": "watch-2",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 2
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "emergency-6",
              "name": "Harbour master",
              "text": "Emergency: ship 5 ZIM CHINA reports reefer power failures; its cargo is at risk unless it docks by hour 64. Each hour it docks later costs 60 on top of any delay."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-11",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Tue 15:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 102: above 25 kn hours 75–85, peak 32 kn; above 30 kn 77–80."
            }
          }
        ]
      },
      {
        "id": "watch-3",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 3
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "late-2",
              "name": "CARLOTA B",
              "text": "Ship 7 CARLOTA B was delayed leaving Alicante: it now arrives at hour 93 (planned slot hour 78). Its planned departure stays hour 121."
            }
          },
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-12",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Wed 03:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 114: above 25 kn hours 75–85, peak 32 kn; above 30 kn 77–80."
            }
          }
        ]
      },
      {
        "id": "watch-4",
        "when": {
          "type": "action",
          "tool": "advance",
          "where": {
            "result.watch": {
              "equals": 4
            }
          }
        },
        "barrier": {
          "at": "provoking_call",
          "timeout_seconds": 60
        },
        "actions": [
          {
            "type": "tool",
            "tool": "port_notice",
            "args": {
              "event_id": "forecast-13",
              "name": "Barcelona Port Control",
              "text": "Wind forecast issued Wed 21:00 (ECMWF, adjusted to the Dique Sur anemometer), to hour 132: above 25 kn hours 78–88, peak 31 kn; above 30 kn 84–85."
            }
          }
        ]
      },
      {
        "id": "watch-5",
        "when": {
          "type": "action",
